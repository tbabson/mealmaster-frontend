# Backend base URL. Leave unset in development — vite.config.js proxies /api to
# http://localhost:8000 instead. Required in production.
VITE_API_URL=https://mealmaster1.onrender.com/api/v1

# VAPID public key for Web Push. Must be the exact counterpart of
# VAPID_PRIVATE_KEY in the backend, or the push service rejects every message.
# Not a secret — it is served to every browser that subscribes.
VITE_VAPID_PUBLIC_KEY=
